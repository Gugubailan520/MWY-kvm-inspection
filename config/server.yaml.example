# 服务端配置模板。复制为 server.local.yaml 后修改。
server:
  http_addr: ":8080"
  cors_origins:
    - "http://localhost:5173"

mysql:
  host: 127.0.0.1
  port: 3306
  user: root
  password: "change-me"
  dbname: kvm_inspection

mongo:
  uri: "mongodb://127.0.0.1:27017"
  database: kvm_inspection
  collection: network_events

jwt:
  secret: "please-change-this-secret-to-random-string"
  expire_hour: 24

log:
  level: info
